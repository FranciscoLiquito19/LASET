# LaTeX build: ignorar artefactos, mas versionar o PDF final
build/*
!template_laset/build/Modelo_LaSET.pdf

# LaTeX temporary files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.lof
*.lot
*~

# Generated report PDF outside the build directory (legacy output path)
/template_laset/Modelo_LaSET.pdf

# VS Code local files
.vscode/*.log

# Private presentation build and review files, and Office lock files
/apresentacao/build/
~$*
hardware/*-backups/
hardware/*.kicad_prl
hardware/gerador/__pycache__/
